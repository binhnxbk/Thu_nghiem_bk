<!DOCTYPE html>
<html lang="vi">
<head>
  <%- include('partials/head', { pageTitle: 'Liên hệ' }) %>
</head>
<body>
  <%- include('partials/header') %>

  <section class="hero" style="padding: 60px 0;">
    <div class="container hero-content">
      <h1 style="font-size:28px;">Liên hệ với chúng tôi</h1>
      <p class="slogan-sub">Để lại thông tin, <%= company.name %> sẽ phản hồi trong thời gian sớm nhất.</p>
    </div>
  </section>

  <section>
    <div class="container contact-grid">
      <div class="contact-info">
        <div class="info-item">
          <div class="info-icon">📍</div>
          <div>
            <h4>Địa chỉ</h4>
            <p><%= company.address %></p>
          </div>
        </div>
        <div class="info-item">
          <div class="info-icon">📞</div>
          <div>
            <h4>Điện thoại</h4>
            <p><%= company.phone %></p>
          </div>
        </div>
        <div class="info-item">
          <div class="info-icon">✉️</div>
          <div>
            <h4>Email</h4>
            <p><%= company.email %></p>
          </div>
        </div>
        <div class="info-item">
          <div class="info-icon">🕐</div>
          <div>
            <h4>Giờ làm việc</h4>
            <p>Thứ 2 - Thứ 7: 8:00 - 17:30</p>
          </div>
        </div>
      </div>

      <div class="contact-form">
        <% if (submitted) { %>
          <div class="alert-success">Cảm ơn bạn đã liên hệ! Chúng tôi sẽ phản hồi sớm nhất có thể.</div>
        <% } %>
        <form method="POST" action="/lien-he">
          <div class="form-group">
            <label for="name">Họ và tên</label>
            <input type="text" id="name" name="name" placeholder="Nguyễn Văn A" required />
          </div>
          <div class="form-group">
            <label for="phone">Số điện thoại</label>
            <input type="tel" id="phone" name="phone" placeholder="09xx xxx xxx" required />
          </div>
          <div class="form-group">
            <label for="message">Nội dung</label>
            <textarea id="message" name="message" rows="5" placeholder="Mô tả nhu cầu / dự án của bạn..." required></textarea>
          </div>
          <button type="submit" class="btn btn-primary" style="border:none; cursor:pointer;">Gửi yêu cầu</button>
        </form>
      </div>
    </div>
  </section>

  <%- include('partials/footer') %>
</body>
</html>
